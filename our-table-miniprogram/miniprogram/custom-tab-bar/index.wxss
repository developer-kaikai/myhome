.tabs { position:fixed; z-index:20; bottom:0; left:0; right:0; display:flex; background:#FAFAF6; border-top:1rpx solid #DDDDD7; padding:16rpx 0 calc(14rpx + env(safe-area-inset-bottom)); }.tab { flex:1; margin:0; min-width:0; background:transparent; border-radius:0; line-height:1.5; font-weight:400; text-align:center; color:#777770; font-size:24rpx; padding:12rpx 0; }.tab::after { border:0; }.active { color:#161616; font-weight:600; }.indicator { margin:8rpx auto 0; width:32rpx; height:4rpx; background:#B8C84A; }
