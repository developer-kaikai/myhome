.home .title {font-size:56rpx;font-weight:600;margin:28rpx 0 44rpx;line-height:1.2;letter-spacing:-1rpx;}.home .eyebrow {margin:0;}.date,.range {color:#8A8A81;font-size:22rpx;}.filters {display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #DDDDD7;border-bottom:1rpx solid #DDDDD7;padding:24rpx 0;gap:20rpx;}.scope {font-size:28rpx;font-weight:500;max-width:290rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}.scope text {margin-left:16rpx;color:#777770;}.periods {display:flex;gap:24rpx;flex-shrink:0;}.period {font-size:26rpx;color:#8A8A81;}.period.active {color:#161616;text-decoration:underline;text-underline-offset:12rpx;}.statistics {padding:38rpx 0 30rpx;}.count {font-size:100rpx;font-weight:500;line-height:1.15;letter-spacing:-3rpx;}.unit {font-size:28rpx;font-weight:400;margin-left:16rpx;letter-spacing:0;}.statistics .muted {margin:12rpx 0;}.trend {display:flex;gap:6rpx;align-items:flex-end;}.point {flex:1;min-width:0;text-align:center;}.track {height:152rpx;display:flex;align-items:flex-end;justify-content:center;border-bottom:1rpx solid #DDDDD7;padding-bottom:4rpx;}.bar {width:100%;max-width:44rpx;background:#B8C84A;min-height:0;border-radius:3rpx 3rpx 0 0;}.future-mark {width:60%;height:12rpx;border-top:2rpx dashed #D1D1C7;}.tick {display:block;font-size:18rpx;color:#8A8A81;height:36rpx;line-height:36rpx;white-space:nowrap;}.trend-note {font-size:22rpx;color:#8A8A81;min-height:38rpx;margin:14rpx 0 38rpx;}.block-heading {display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;border-top:1rpx solid #DDDDD7;font-size:30rpx;font-weight:500;}.block-heading .muted {font-size:22rpx;font-weight:400;}.popular {display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid #E7E7DF;}.rank {font-size:28rpx;color:#AAAA9F;width:28rpx;}.food {flex:1;min-width:0;}.food-name {font-size:28rpx;font-weight:500;}.food .muted {font-size:22rpx;margin-top:8rpx;}.times {font-size:34rpx;font-weight:50