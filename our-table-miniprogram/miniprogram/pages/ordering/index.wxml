<view class="page" wx:if="{{ready}}">
  <view class="eyebrow">OUR TABLE / 一起选菜</view><view class="title"><text>今天，
想吃点什么？</text></view>
  <view class="restaurants"><view wx:for="{{restaurants}}" wx:key="id" data-index="{{index}}" bindtap="restaurant" class="restaurant {{restaurantIndex === index ? 'selected' : ''}}">{{item.name}}</view></view>
  <picker mode="selector" range="{{dates}}" value="{{dateIndex}}" bindchange="date" disabled="{{loading || busy || retryPending}}"><view class="row section"><text class="muted">用餐日期</text><text>{{date}} ↓</text></view></picker>
  <view class="meals"><view wx:for="{{mealTabs}}" wx:key="meal" data-meal="{{item.meal}}" bindtap="meal" class="meal {{meal === item.meal ? 'chosen' : ''}} {{!item.open ? 'unavailable' : ''}}">{{item.name}}<text class="meal-note" wx:if="{{!item.open}}">已截止</text></view></view>
  <view class="error" wx:if="{{error}}">{{error}}<text class="link" bindtap="load">重试</text></view>
  <view class="error" wx:if="{{syncError}}">{{syncError}}<text wx:if="{{retryPending}}" class="link" bindtap="retry">核对并重试</text></view>
  <view class="link" wx:if="{{closed && !retryPending && !accessRequired}}" >请切换上方日期或餐次</view>
  <view class="link" wx:if="{{accessRequired && !retryPending}}" bindtap="verifyAccess">重新验证日常资格</view>
  <view wx:if="{{loading}}" class="notice">正在加载菜单和清单…</view>
  <view class="menu" wx:else>
    <view class="categories"><view wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="category" class="category {{categoryId === item.id ? 'chosen' : ''}}">{{item.name}}</view></view>
    <view class="dishes"><view class="dish" wx:for="{{visibleDishes}}" wx:key="id"><view data-id="{{item.id}}" bindtap="detail"><view class="dish-art">{{item.name}}</view><view class="dish-name">{{item.name}} <text class="hot" wx:if="{{item.hot}}">HOT</text></view><view class="muted intro" wx:if="{{item.introduction}}">{{item.introduction}}</view></view><view class="muted rating">{{item.scoreText}} · {{item.reviewCount || 0}} 条评价</view><view class="dish-footer"><text>{{item.dimensions.length ? '可选规格' : '家常味道'}}</text><button class="add" data-id="{{item.id}}" bindtap="plus" disabled="{{busy || retryPending || closed || !cart}}">＋</button></view></view><view class="empty" wx:if="{{!visibleDishes.length}}">这里还没有上架的菜，<text class="empty-note">等主厨加一道拿手菜。</text></view></view>
  </view>
  <view class="notice">{{cart.status === 'IN_PROGRESS' ? '新增选择先进入追加清单，提交后才并入正式餐单。' : '选菜会同步给一起点餐的人，尚未提交为餐单。'}}</view>
  <view class="link" wx:if="{{cart.status === 'IN_PROGRESS'}}" bindtap="viewOrder">查看已提交餐单 ›</view>
  <view class="cart-bar" wx:if="{{!closed || cart}}" bindtap="openCart"><view><text class="cart-title">已选清单</text><text class="muted cart-summary">{{cart ? cart.dishCount : 0}} 道菜 · {{cart ? cart.quantity : 0}} 份 · {{cart ? cart.contributorCount : 0}} 人点菜</text></view><text>查看 ↑</text></view>
</view>
<view class="overlay" wx:if="{{cartOpen}}" bindtap="closeCart"><view class="drawer" catchtap="noop">
  <view class="row"><text class="subtitle">已选清单</text><text class="link" bindtap="closeCart">收起</text></view><text class="muted">{{date}} · {{meal === 'BREAKFAST' ? '早餐' : meal === 'LUNCH' ? '午餐' : meal === 'DINNER' ? '晚餐' : '宵夜'}} · {{restaurants[restaurantIndex].name}}</text>
  <scroll-view scroll-y class="drawer-scroll"><block wx:if="{{submittedItems.length}}"><view class="subtitle">已提交菜品</view><view wx:for="{{submittedItems}}" wx:key="id" class="cart-item"><view class="row"><text>{{item.dishName}}</text><text class="link" data-id="{{item.id}}" bindtap="removeItem">移除</text></view><view class="muted">{{item.specText}} · {{item.contributorName}} 点的</view><view class="row"><text class="link" data-id="{{item.id}}" bindtap="editItem">修改规格</text><view class="quantity"><button class="quantity-button" data-id="{{item.id}}" data-delta="-1" bindtap="delta" disabled="{{busy || retryPending || closed}}">−</button><text>{{item.quantity}}</text><button class="quantity-button" data-id="{{item.id}}" data-delta="1" bindtap="delta" disabled="{{busy || retryPending || closed}}">＋</button></view></view></view><view class="subtitle">未提交的追加</view></block><view wx:for="{{cartItems}}" wx:key="id" class="cart-item"><view class="row"><text>{{item.dishName}}</text><text class="link" data-id="{{item.id}}" bindtap="removeItem">移除</text></view><view wx:if="{{item.specText}}" class="muted">{{item.specText}}</view><view class="muted">{{item.contributorName}} 点的</view><view class="row"><text class="link" data-id="{{item.id}}" bindtap="editItem">修改规格</text><view class="quantity"><button class="quantity-button" data-id="{{item.id}}" data-delta="-1" bindtap="delta" disabled="{{busy || retryPending || closed}}">−</button><text>{{item.quantity}}</text><button class="quantity-button" data-id="{{item.id}}" data-delta="1" bindtap="delta" disabled="{{busy || retryPending || closed}}">＋</button></view></view></view><view class="empty" wx:if="{{!cartItems.length}}">还没选菜，一起挑几道喜欢的。</view></scroll-view>
  <view class="error" wx:if="{{syncError}}">{{syncError}}<text wx:if="{{retryPending}}" class="link" bindtap="retry">核对并重试</text></view><button class="secondary" bindtap="clear" disabled="{{busy || retryPending || closed || !cartItems.length}}">{{cart.status === 'IN_PROGRESS' ? '清空未提交追加' : '清空已选清单'}}</button><button class="primary" bindtap="submitCart" disabled="{{busy || retryPending || closed || !cartItems.length}}">{{cart.status === 'IN_PROGRESS' ? '复核并提交追加' : '复核并提交餐单'}}</button><view class="notice">{{cart.status === 'IN_PROGRESS' ? '修改已提交菜品会直接保存；追加需再次提交。' : '提交前请核对最新菜品、人数与备注。'}}</view>
</view></view>
<view class="overlay dish-overlay" wx:if="{{dish}}" bindtap="closeDish"><view class="drawer" catchtap="noop">
  <view class="row"><text class="subtitle">{{dish.name}}</text><text class="link" bindtap="closeDish">关闭</text></view><view class="muted" wx:if="{{dish.introduction}}">{{dish.introduction}}</view>
  <view class="notice">{{restaurants[restaurantIndex].name}} · {{date}} · {{meal === 'BREAKFAST' ? '早餐' : meal === 'LUNCH' ? '午餐' : meal === 'DINNER' ? '晚餐' : '宵夜'}}</view>
  <text class="link" bindtap="dishReviews">看看大家的评价 ›</text>
  <scroll-view wx:if="{{choices.length}}" scroll-y class="spec-scroll"><view wx:for="{{choices}}" wx:key="id" wx:for-item="dimension" class="spec"><text>{{dimension.name}}</text><view class="options"><view wx:for="{{dimension.options}}" wx:key="id" class="option {{item.selected ? 'chosen' : ''}}" data-dimension="{{dimension.id}}" data-option="{{item.id}}" bindtap="choose">{{item.name}}</view></view></view></scroll-view>
  <view class="error" wx:if="{{syncError}}">{{syncError}}<text wx:if="{{retryPending}}" class="link" bindtap="retry">核对并重试</text></view><button class="primary" bindtap="saveDish" disabled="{{busy || retryPending || closed}}" loading="{{busy}}">{{editing ? '保存规格' : '加入已选清单'}}</button>
</view></view>
