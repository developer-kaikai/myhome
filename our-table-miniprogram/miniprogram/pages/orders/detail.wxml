<view class="page" wx:if="{{ready}}"><view class="eyebrow">OUR TABLE / {{stateName}}</view><view class="title">{{order.restaurantName}}</view><view class="subtitle">{{order.date}} · {{mealName}}</view><view class="notice" wx:if="{{loading}}">正在获取餐单…</view><view class="error" wx:if="{{error}}">{{error}}<text class="link" wx:if="{{retryPending}}" bindtap="retry">核对结果并重试</text></view><block wx:if="{{order}}">
<view class="row section"><text>{{order.dinerCount}} 人用餐</text><text>{{stateName}}</text></view><view class="notice" wx:if="{{order.confirmationDue}}">待本店主厨确认这顿饭，确认后才计入做饭次数。</view><view class="notice" wx:if="{{order.remark}}">备注：{{order.remark}}</view><view class="notice" wx:if="{{order.cancelReason}}">取消原因：{{order.cancelReason}}</view>
<view class="section" wx:if="{{order.status === 'COMPLETED'}}"><view class="subtitle">实际做过的菜</view><view class="item" wx:for="{{actual}}" wx:key="id"><view class="row"><text>{{item.dishName}}</text><text>{{item.quantity}} 份</text></view><view class="muted">{{item.specText}}{{item.sourceType === 'CONFIRM_ADDED' ? ' · 主厨确认时补充' : ''}}</view></view><view class="notice">完成于 {{completedText}}（北京时间）</view></view>
<view class="section"><view class="subtitle">原点单记录</view><view class="item" wx:for="{{items}}" wx:key="id"><view class="row"><text>{{item.dishName}}</text><text>{{item.quantity}} 份</text></view><view class="muted">{{item.specText}}</view><view class="muted">{{item.contributorName}} 点的{{item.notMade ? ' · 未在实际清单中' : ''}}</view><text class="link" wx:if="{{order.ownChef}}" data-id="{{item.id}}" bindtap="recipe">查看提交时做法</text></view></view>
<view class="section" wx:if="{{pending.length}}"><view class="subtitle">{{order.status === 'IN_PROGRESS' ? '尚未提交的追加' : '结束时未提交的选择'}}</view><view class="item" wx:for="{{pending}}" wx:key="id"><view class="row"><text>{{item.dishName}}</text><text>{{item.quantity}} 份</text></view><view class="muted">{{item.specText}} · {{item.contributorName}} 点的{{item.notMade ? ' · 未在实际清单中' : ''}}</view></view><button class="secondary" wx:if="{{order.canModify}}" bindtap="append" disabled="{{busy || retryPending}}">复核并提交追加</button></view>
<view class="notice">参与者：{{participants}}</view><view class="notice" wx:if="{{order.status === 'IN_PROGRESS'}}">{{notificationText}}</view>
<view class="section" wx:if="{{subscription.enabled && order.status === 'IN_PROGRESS'}}"><view class="subtitle">饭后，留下一点回味</view><view class="muted">参与点餐后，可订阅一条完成评价邀请。无需订阅也能从餐单页评价。</view><button class="secondary" bindtap="subscribe" loading="{{subscribing}}" disabled="{{subscribing || busy || retryPending}}">订阅完成评价邀请</button><view class="notice">{{subscriptionNote}}</view></view><button class="primary" wx:if="{{order.status === 'COMPLETED'}}" bindtap="reviewMeal">评价 / 回看这顿饭</button>
<button class="primary" wx:if="{{order.canConfirm}}" bindtap="confirmMeal" disabled="{{busy || retryPending}}">确认这顿饭</button>
<button class="primary" wx:if="{{order.canModify}}" bindtap="modify" disabled="{{busy || retryPending}}">继续选菜 / 修改菜品</button><button class="secondary" wx:if="{{order.canMeta}}" bindtap="edit" disabled="{{busy || retryPending}}">修改人数与备注</button><button class="secondary" wx:if="{{order.canCancel && !cancelForm}}" bindtap="openCancel" disabled="{{busy || retryPending}}">取消餐单</button>
<view class="section" wx:if="{{cancelForm && order.canCancel}}"><textarea value="{{cancelReason}}" bindinput="reason" maxlength="2048" placeholder="取消原因，选填，最多100字" disabled="{{busy || retryPending}}"/><button class="secondary" bindtap="cancel" disabled="{{busy || retryPending}}">确认取消整张餐单</button></view><button class="primary" wx:if="{{order.canReopen}}" bindtap="reopen" disabled="{{busy || retryPending}}">重新点餐</button><view class="muted">{{order.orderNo}}</view></block></view>
<view class="overlay" wx:if="{{edit}}" catchtap="closeEdit"><view class="drawer" catchtap="noop"><view class="row"><text class="subtitle">人数与备注</text><text class="link" bindtap="closeEdit">关闭</text></view><input type="number" value="{{count}}" bindinput="count" disabled="{{busy || retryPending}}"/><textarea value="{{remark}}" bindinput="remark" maxlength="2048" disabled="{{busy || retryPending}}" placeholder="备注，选填，最多100字"/><view class="error" wx:if="{{error}}">{{error}}<text class="link" wx:if="{{retryPending}}" bindtap="retry">核对结果并重试</text></view><button class="primary" bindtap="saveMeta" disabled="{{busy || retryPending}}" loading="{{busy}}">保存</button></view></view>
