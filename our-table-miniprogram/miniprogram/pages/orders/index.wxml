<view class="page" wx:if="{{ready}}"><view class="eyebrow">OUR TABLE / 餐单</view><view class="title">每一餐，<text class="line">都是小日常。</text></view><view class="notice" wx:if="{{chefOnly}}">仅查看本店餐单 <text class="link" bindtap="all">查看全部可访问餐单</text></view><view class="filters"><text data-state="IN_PROGRESS" bindtap="filter" class="filter {{state === 'IN_PROGRESS' ? 'chosen' : ''}}">进行中</text><text data-state="HISTORY" bindtap="filter" class="filter {{state === 'HISTORY' ? 'chosen' : ''}}">全部历史</text><text data-state="COMPLETED" bindtap="filter" class="filter {{state === 'COMPLETED' ? 'chosen' : ''}}">已完成</text><text data-state="CANCELLED" bindtap="filter" class="filter {{state === 'CANCELLED' ? 'chosen' : ''}}">已取消</text></view><view class="error" wx:if="{{error}}">{{error}}<text class="link" bindtap="load">重试</text></view><view class="notice" wx:if="{{loading}}">正在获取最新餐单…</view><view class="card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="subtitle">{{item.restaurantName}}</text><text>{{item.stateName}}</text></view><view class="muted">{{item.date}} · {{item.mealName}} · {{item.dinerCount}} 人</view><view class="summary">{{item.summary}}</view><view class="muted">参与者：{{item.names}}</view><view class="muted" wx:if="{{item.remark}}">备注：{{item.remark}}</view><view class="notice" wx:if="{{item.confirmationDue}}">待确认这顿饭</view><view class="link">查看餐单 ›</view></view><view class="empty" wx:if="{{!loading && !orders.length}}">这里还没有餐单。</view><view class="row section" wx:if="{{page > 1 || hasMore}}"><button class="secondary" bindtap="previous" disabled="{{loading || page <= 1}}">上一页</button><text>{{page}}</text><button class="secondary" bindtap="next" disabled="{{loading || !hasMore}}">下一页</button></view><button class="primary" bindtap="start">一起选菜</button></view>
