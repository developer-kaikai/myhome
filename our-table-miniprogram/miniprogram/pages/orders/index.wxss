.line{display:block}.filters{display:flex;gap:16rpx;flex-wrap:wrap;margin-bottom:32rpx}.filter{padding:16rpx 20rpx;border-radius:12rpx;font-size:24rpx;color:#777770}.chosen{background:#F0F1E6;color:#161616}.card{padding:24rpx 0;margin:16rpx 0;border-bottom:1rpx solid #DDDDD7}.card .subtitle{margin:0}.summary{margin:20rpx 0}.muted{font-size:24rpx;line-height:1.8}.page{padding-bottom:calc(160rpx + env(safe-area-inset-bottom))}
