<view class="page" wx:if="{{ready}}"><view class="eyebrow">OUR TABLE / {{append ? '确认追加' : '确认餐单'}}</view><view class="title">一起选好的，<text class="line">就做这一餐。</text></view><view class="subtitle">{{restaurantName}} · {{date}} · {{mealName}}</view>
<view class="notice" wx:if="{{loading}}">正在复核最新清单…</view><view class="error" wx:if="{{error}}">{{error}}</view>
<view class="notice" wx:if="{{changed}}">{{notice}}<button class="secondary" bindtap="acknowledge" disabled="{{busy || retryPending}}">已核对，使用最新清单</button></view>
<view class="section" wx:if="{{append}}"><view class="subtitle">已提交，保持不变</view><view class="muted">{{formalSummary}}</view></view>
<view class="section"><view class="subtitle">{{append ? '本次追加' : '本餐菜品'}}</view><view class="item" wx:for="{{rows}}" wx:key="id"><view class="row"><text>{{item.dishName}}</text><text>{{item.quantity}} 份</text></view><view class="muted">{{item.specText}}</view><view class="muted">{{item.contributorName}} 点的</view><view class="error" wx:if="{{item.invalid}}">{{item.invalid}}</view></view><view class="muted" wx:if="{{!rows.length}}">没有待提交菜品</view></view>
<view class="section"><view class="row"><text>用餐人数</text><input class="count" type="number" value="{{dinerCount}}" bindinput="count" disabled="{{!editableMeta || busy || retryPending}}" /></view><view class="muted">1—20 人，人数不需要与点餐账号数一致</view><textarea value="{{remark}}" maxlength="2048" bindinput="remark" placeholder="整单备注，选填，最多100个可见字符" disabled="{{!editableMeta || busy || retryPending}}" /><view class="tags" wx:if="{{editableMeta}}"><text class="tag" data-value="少辣" bindtap="tag">少辣</text><text class="tag" data-value="清淡一点" bindtap="tag">清淡一点</text><text class="tag" data-value="不放香菜" bindtap="tag">不放香菜</text></view></view>
<view class="notice">参与者：{{participants}}</view><view class="notice">提交后直接进行中，主厨无需接单。微信提醒需收件人自行订阅，可从餐单页查看。</view><view class="section" wx:if="{{subscription.enabled}}"><view class="subtitle">饭后，留下一点回味</view><view class="muted">参与点餐后，可订阅一条完成评价邀请。无需订阅也能从餐单页评价。</view><button class="secondary" bindtap="subscribe" loading="{{subscribing}}" disabled="{{subscribing || busy || retryPending}}">订阅完成评价邀请</button><view class="notice">{{subscriptionNote}}</view></view><button class="primary" bindtap="submit" disabled="{{busy || (!retryPending && (!canSubmit || changed))}}" loading="{{busy}}">{{retryPending ? '核对结果并重试' : append ? '确认追加' : '提交餐单'}}</button><button class="secondary" bindtap="back" disabled="{{busy}}">返回选菜</button></view>
