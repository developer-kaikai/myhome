.party-name{font-size:36rpx;font-weight:600}.selected{font-weight:600;border-bottom:3rpx solid #B8C84A}.notice{margin:16rpx 0}.field-label{margin-top:32rpx;font-weight:600}.dates{display:flex;gap:20rpx}.dates picker{flex:1}.date-value{padding:24rpx;background:#F3F3EF;margin:16rpx 0}.detail-theme{font-size:52rpx;line-height:1.2;margin:32rpx 0}.member{display:flex;justify-content:space-between;padding:16rpx 0}.badge{font-size:24rpx;color:#777770}.actions button{margin-top:16rpx}
.cover-preview,.party-cover{display:block;width:100%;height:400rpx;background:#F4F2E9;margin:24rpx 0}.cover-choices{display:flex;gap:16rpx;margin:16rpx 0 32rpx}.cover-choice{flex:1;min-width:0;font-size:22rpx;line-height:1.5;color:#777770;padding-bottom:12rpx;border-bottom:3rpx solid transparent}.cover-chosen{color:#161616;border-color:#B8C84A}.cover-thumb{display:block;width:100%;height:108rpx;background:#F4F2E9;margin-bottom:10rpx}.party-list-cover{display:block;width:100%;height:280rpx;background:#F4F2E9;margin-bottom:24rpx}
