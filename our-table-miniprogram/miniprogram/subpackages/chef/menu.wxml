<view class="page">
  <view class="eyebrow">主厨工作台 / 我的菜单</view>
  <view class="title">常做的，<text>都在这里。</text></view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button wx:if="{{!ready}}" class="secondary" bindtap="load">重新加载</button>
  <block wx:if="{{ready}}">
    <view class="subtitle">餐厅名称</view>
    <input class="input" value="{{name}}" maxlength="510" bindinput="inputName" placeholder="给餐厅取个名字" />
    <button class="secondary" disabled="{{busy}}" bindtap="rename">保存名称</button>
    <view class="subtitle">菜单品类</view>
    <view wx:for="{{categories}}" wx:key="id" class="row section">
      <text>{{item.name}}</text><text wx:if="{{item.type === 'SEASONAL'}}" class="muted">固定品类</text>
      <view wx:else class="actions"><text data-id="{{item.id}}" bindtap="editCategory">编辑</text><text data-id="{{item.id}}" bindtap="removeCategory" class="danger">删除</text></view>
    </view>
    <input class="input" value="{{categoryName}}" maxlength="510" bindinput="inputCategory" placeholder="{{editingCategory ? '修改品类名称' : '新建品类名称'}}" />
    <button class="secondary" disabled="{{busy || !categoryName}}" bindtap="saveCategory">{{editingCategory ? '保存品类' : '添加品类'}}</button>
    <text wx:if="{{editingCategory}}" class="link" bindtap="cancelCategory">取消编辑</text>
    <view class="row"><view class="subtitle">菜品 · {{dishes.length}}</view><text class="link" bindtap="createDish">添加菜品 ＋</text></view>
    <view class="row section" wx:for="{{dishes}}" wx:key="id" data-id="{{item.id}}" bindtap="editDish"><view><text>{{item.name}}</text><view class="muted">{{item.introduction || '留一点期待给这道菜'}}</view></view><text class="muted">{{item.onShelf ? '上架中' : '已下架'}} ›</text></view>
    <view class="empty" wx:if="{{!dishes.length}}">先添加一道你们爱吃的菜。</view>
  </block>
</view>
