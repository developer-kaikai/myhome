<view class="page"><view class="eyebrow">OUR TABLE / 和朋友相聚</view><view class="title"><text>留一张桌，
一起好好吃饭。</text></view><button wx:if="{{!loggedIn}}" class="primary" bindtap="signIn" loading="{{busy}}" disabled="{{busy}}">微信登录，查看我的聚会</button><block wx:else><view class="row section"><text data-state="ACTIVE" bindtap="tab" class="{{state==='ACTIVE'?'selected':'muted'}}">当前聚会</text><text data-state="ENDED" bindtap="tab" class="{{state==='ENDED'?'selected':'muted'}}">历史聚会</text><text wx:if="{{daily}}" class="link" bindtap="create">创建 ＋</text></view><view class="muted" wx:if="{{loading}}">正在查看聚会…</view><view class="empty" wx:if="{{!loading && !error && !parties.length}}">{{state==='ACTIVE'?'还没有当前聚会。':'还没有结束的聚会。'}}<button wx:if="{{daily && state==='ACTIVE'}}" class="primary" bindtap="create">邀请朋友吃顿饭</button><view wx:else class="notice">通过朋友发来的聚会邀请，可报名参加。</view></view><view class="section" wx:for="{{parties}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image class="party-list-cover" src="{{item.coverImage}}" mode="aspectFit" data-id="{{item.id}}" binderror="coverError"/><view class="row"><text class="party-name">{{item.theme}}</text><text class="muted">{{item.statusText}} ›</text></view><view class="muted">{{item.timeText}} · {{item.location}}</view><view class="notice">成员 {{item.memberCount}} 人{{item.membership==='EXITED'?' · 我已退出':item.membership==='REMOVED'?' · 我已被移除':''}}</view></view><view class="row"><button class="secondary" wx:if="{{page>1}}" bindtap="previous" disabled="{{loading}}">上一页</button><button class="secondary" wx:if="{{hasMore}}" bindtap="next" disabled="{{loading}}">下一页</button></view></block><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load" disabled="{{loading}}">重试</button></view><view class="link" wx:if="{{loggedIn && !daily}}" bindtap="mine">个人资料 ›</view></view>