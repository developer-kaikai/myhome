<view class="page">
 <view class="eyebrow">OUR TABLE / 聚会采购</view><view class="title">带点好吃的来。</view>
 <button wx:if="{{!loggedIn}}" class="primary" bindtap="signIn" disabled="{{busy}}">微信登录，查看采购</button>
 <view class="muted" wx:if="{{loading}}">正在核对清单和费用…</view>
 <block wx:if="{{loggedIn && listing}}">
  <view class="bill"><view class="muted">总支出 · {{listing.summary.purchasedCount}} 项已购</view><view class="total"><text class="currency">¥</text>{{listing.summary.total}}</view><view class="notice">{{listing.summary.memberCount}} 人 · 人均参考 {{listing.summary.perPerson===null?'暂无法计算':'¥'+listing.summary.perPerson}}</view><view class="muted">按当前报名人数平均，不生成转账或欠款。</view></view>
  <view class="link" bindtap="toggleAdvances">各自垫付 {{showAdvances?'收起 −':'展开 ＋'}}</view><view wx:if="{{showAdvances}}" class="advance" wx:for="{{listing.summary.advances}}" wx:key="userId"><view>{{item.name}}<text class="muted" wx:if="{{item.status!=='JOINED'}}"> · {{item.status==='EXITED'?'已退出成员':'已移除成员'}}</text></view><text>¥{{item.amount}}</text></view>
  <view class="section"><view class="subtitle">采购清单 · {{listing.summary.itemCount}} 项</view><view class="notice" wx:if="{{!listing.canAdd}}">当前为只读，可回看采购和费用。</view>
   <view class="empty" wx:if="{{!listing.summary.itemCount}}">还没有采购物品，先添一道大家想吃的。</view>
   <view class="purchase" wx:for="{{listing.items}}" wx:key="id">
    <view data-id="{{item.id}}" bindtap="edit"><view class="item-top"><text class="item-name">{{item.name}}</text><text>{{item.status==='PURCHASED'?'¥'+item.amount:'待购买'}}</text></view><view class="notice">{{item.quantity || '数量待定'}} · {{item.assigneeName || '待认领'}}<text wx:if="{{item.status==='PURCHASED'}}"> · {{item.payerName}}垫付</text></view></view>
    <view class="item-actions"><button wx:if="{{item.canClaim}}" class="small" data-id="{{item.id}}" data-action="CLAIM" bindtap="quick" disabled="{{busy || retryPending || conflicted || editing}}">我来买</button><button wx:if="{{item.canRelease}}" class="small" data-id="{{item.id}}" data-action="RELEASE" bindtap="quick" disabled="{{busy || retryPending || conflicted || editing}}">解除认领</button><button wx:if="{{item.canEdit || item.canPurchase || listing.creator}}" class="small" data-id="{{item.id}}" bindtap="edit" disabled="{{busy || retryPending}}">{{item.status==='PURCHASED'?'查看 / 修正':'填写购买 / 编辑'}}</button></view>
   </view>
   <view class="pagination" wx:if="{{listing.hasMore || page>1}}"><button class="small" data-page="{{page-1}}" bindtap="page" disabled="{{page===1 || busy || retryPending || editing}}">上一页</button><text>{{page}} 页</text><button class="small" data-page="{{page+1}}" bindtap="page" disabled="{{!listing.hasMore || busy || retryPending || editing}}">下一页</button></view>
   <button wx:if="{{listing.canAdd && !editing}}" class="primary" bindtap="add" disabled="{{busy || retryPending}}">＋ 添加采购物品</button>
  </view>
  <view id="purchase-editor" class="editor" wx:if="{{editing}}">
   <view class="subtitle">{{selected?'采购记录':'添加物品'}}</view>
   <view class="notice" wx:if="{{selected}}">{{selected.assigneeName || '待认领'}} · {{selected.status==='PURCHASED'?'已购买':'待购买'}}</view>
   <block wx:if="{{selected && selected.status==='PURCHASED' && (!listing.canAdd || !selected.canPurchase)}}"><view class="notice">{{selected.payerName}} 已垫付 ¥{{selected.amount}}</view><view class="muted" wx:if="{{selected.zeroNote}}">说明：{{selected.zeroNote}}</view></block>
   <view class="field-label">物品名称 · 最多20字</view><input class="input" maxlength="-1" value="{{name}}" data-field="name" bindinput="input" disabled="{{busy || retryPending || !listing.canAdd || (selected && !selected.canEdit)}}" placeholder="例如：牛肉、橙汁"/>
   <view class="field-label">数量与单位 · 选填，最多10字</view><input class="input" maxlength="-1" value="{{quantity}}" data-field="quantity" bindinput="input" disabled="{{busy || retryPending || !listing.canAdd || (selected && !selected.canEdit)}}" placeholder="例如：2斤、3瓶"/>
   <block wx:if="{{listing.canAdd && (!selected || listing.creator)}}"><view class="field-label">采购负责人</view><picker range="{{assignees}}" range-key="name" value="{{assigneeIndex}}" data-field="assigneeIndex" bindchange="pick" disabled="{{busy || retryPending}}"><view class="input">{{assignees[assigneeIndex].name}} ›</view></picker><view class="muted" wx:if="{{!listing.creator}}">普通成员请选择待认领或自己购买。</view><button wx:if="{{selected && listing.creator}}" class="secondary" bindtap="assign" disabled="{{busy || retryPending || conflicted}}">更新负责人</button></block>
   <button wx:if="{{listing.canAdd && (!selected || selected.canEdit)}}" class="secondary" bindtap="saveInfo" disabled="{{busy || retryPending || conflicted}}">{{selected?'保存物品信息':'添加到清单'}}</button>
   <block wx:if="{{listing.canAdd && selected && selected.canPurchase}}"><view class="field-label">实际垫付金额 · 元</view><input class="input" type="digit" value="{{amount}}" data-field="amount" bindinput="input" disabled="{{busy || retryPending}}" placeholder="0—99999.99"/><view class="field-label">实际垫付人</view><picker range="{{payers}}" range-key="name" value="{{payerIndex}}" data-field="payerIndex" bindchange="pick" disabled="{{busy || retryPending || (selected.status==='PURCHASED' && !listing.creator)}}"><view class="input">{{payers[payerIndex].name}} ›</view></picker><view class="field-label">0元说明 · 赠送或自有，最多100字</view><input class="input" maxlength="-1" value="{{zeroNote}}" data-field="zeroNote" bindinput="input" disabled="{{busy || retryPending}}"/></block>
   <block wx:if="{{listing.canAdd && selected && selected.status==='PURCHASED' && (selected.canEdit || selected.canPurchase)}}"><view class="field-label">修改、移除或撤回原因 · 最多100字</view><input class="input" maxlength="-1" value="{{reason}}" data-field="reason" bindinput="input" disabled="{{busy || retryPending}}" placeholder="例如：退货、金额填错"/></block>
   <button wx:if="{{listing.canAdd && selected && selected.canPurchase}}" class="primary" bindtap="purchase" disabled="{{busy || retryPending || conflicted}}">{{selected.status==='PURCHASED'?'确认修正购买记录':'确认已购买'}}</button>
   <block wx:if="{{listing.canAdd && selected && selected.canEdit}}"><button class="danger" data-action="REVERT" bindtap="remove" wx:if="{{selected.status==='PURCHASED'}}" disabled="{{busy || retryPending || conflicted}}">撤回为待购买</button><button class="danger" data-action="REMOVE" bindtap="remove" disabled="{{busy || retryPending || conflicted}}">移除物品</button></block>
   <button wx:if="{{conflicted}}" class="secondary" bindtap="latest" disabled="{{busy || retryPending}}">加载最新项目，重新确认</button><button class="secondary" bindtap="cancel" disabled="{{busy || retryPending}}">收起</button>
  </view>
 </block>
 <view class="error" wx:if="{{error}}">{{error}}</view><button wx:if="{{retryPending}}" class="primary" bindtap="retry" disabled="{{busy}}" loading="{{busy}}">核对上次操作</button><button wx:elif="{{loggedIn}}" class="secondary" bindtap="load" disabled="{{busy || loading}}">刷新采购与费用</button><view class="link" bindtap="detail">聚会详情 ›</view>
</view>
