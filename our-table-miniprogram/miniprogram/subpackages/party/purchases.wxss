@import "detail.wxss";
.bill{padding:32rpx 0 44rpx;border-bottom:1rpx solid #e5e5df;margin-bottom:32rpx}.total{font-size:80rpx;font-weight:500;letter-spacing:-3rpx;line-height:1.4;font-variant-numeric:tabular-nums}.currency{font-size:32rpx;letter-spacing:0;margin-right:12rpx}.advance,.item-top,.pagination{display:flex;justify-content:space-between;align-items:center;gap:20rpx}.advance{padding:14rpx 0;font-size:26rpx}.advance>view{min-width:0;word-break:break-all}.purchase{padding:24rpx 0;border-bottom:1rpx solid #e5e5df}.item-top{align-items:flex-start}.item-name{font-weight:500;min-width:0;overflow-wrap:anywhere;flex:1}.item-top>text:last-child{flex-shrink:0}.item-actions{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:10rpx}.small{font-size:24rpx;padding:0 20rpx;line-height:2.5;margin:0;background:#edeee6;border-radius:8rpx}.small::after{border:none}.pagination{margin:24rpx 0;font-size:24rpx}.editor{padding:28rpx 24rpx;margin:24rpx -8rpx;background:#f1f2e9;border-radius:16rpx}.field-label{margin-top:26rpx}.empty{padding:32rpx 0;color:#777770;line-height:1.7}.input{background:#fafaf6}button[disabled]{opacity:.45}
