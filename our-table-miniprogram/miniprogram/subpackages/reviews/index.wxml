<view class="page"><view class="eyebrow">OUR TABLE / REVIEWS</view><view class="title">{{dishId ? '大家怎么说' : '每一餐的回声'}}</view><button class="primary" wx:if="{{!loggedIn}}" bindtap="signIn" disabled="{{busy}}">微信登录</button><block wx:else><view class="notice" wx:if="{{dishId}}">均分 {{averageText}} · {{reviewCount}} 条评价</view><view class="tabs" wx:if="{{!dishId}}"><text class="{{state === 'invitations' ? 'active' : ''}}" data-state="invitations" bindtap="tab">待评价 / 回看</text><text class="{{state === 'mine' ? 'active' : ''}}" data-state="mine" bindtap="tab">我发表的</text></view><view class="notice" wx:if="{{loading}}">正在获取记录…</view><view class="section" wx:for="{{invitations}}" wx:key="orderId" data-id="{{item.orderId}}" bindtap="open"><view class="subtitle">{{item.restaurantName}}</view><view class="muted">{{item.date}} · {{item.mealName}} · 已评 {{item.reviewed}} / {{item.total}} 道</view><view class="muted">评价有效至 {{item.deadlineText}}（北京时间）</view><text class="link">查看这顿饭的评价 ›</text></view><view class="section" wx:for="{{reviews}}" wx:key="id"><view class="row"><text class="subtitle">{{item.dishName}}</text><text>{{item.rating}} 星</text></view><view class="muted"><image class="avatar" wx:if="{{item.reviewerAvatar}}" src="{{item.reviewerAvatar}}"/>{{item.reviewerName}} · {{item.timeText}}</view><view class="comment">{{item.comment || '没有填写文字'}}</view><text class="link" wx:if="{{!dishId}}" data-id="{{item.orderId}}" bindtap="open">{{item.canModify ? '修改我的评价 ›' : '回看这顿饭 ›'}}</text></view><view class="notice" wx:if="{{!loading && !error && !reviews.length && !invitations.length}}">还没有评价记录。</view><view class="row"><button class="secondary" wx:if="{{page > 1}}" bindtap="previous">上一页</button><button class="secondary" wx:if="{{hasMore}}" bindtap="next">下一页</button></view></block><view class="error" wx:if="{{error}}">{{error}}</view></view>
