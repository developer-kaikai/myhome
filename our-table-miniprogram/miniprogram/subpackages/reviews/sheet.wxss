.title text{display:block}.muted{font-size:24rpx;line-height:1.8}.my-review{margin-top:24rpx;font-size:26rpx}.comment{white-space:pre-wrap;line-height:1.8;padding:14rpx 0}.overlay{position:fixed;inset:0;background:#00000055;z-index:100;display:flex;align-items:flex-end}.drawer{width:100%;box-sizing:border-box;border-radius:28rpx 28rpx 0 0;background:#FAFAF6;padding:32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));max-height:85vh;overflow-y:auto}.stars{display:flex;justify-content:space-between;gap:8rpx;margin:30rpx 0}.star{padding:0;width:90rpx;height:84rpx;line-height:84rpx;margin:0;font-size:52rpx;background:transparent;color:#9C9C94}.star.selected{color:#3A5848}
.avatar{width:44rpx;height:44rpx;border-radius:50%;vertical-align:middle;margin-right:12rpx}
